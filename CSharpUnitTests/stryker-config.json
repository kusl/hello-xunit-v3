{
  "stryker-config": {
    "project": "CSharpClassLibrary.csproj",
    "test-runner": "mtp",
    "mutation-level": "Complete",
    "coverage-analysis": "off",
    "disable-bail": true,
    "disable-mix-mutants": true,
    "concurrency": 1,
    "break-on-initial-test-failure": true,
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
